# Copy to `automation/.env` and fill in. `.env` is gitignored; this example file is not.

# Anthropic API key for the LLM discovery agent.
# Required for `npm run discover` and for `scripts/demo-discovery-stuck.ts`; both fail
# fast with an explicit error if this is left blank. Every other command works without it.
ANTHROPIC_API_KEY=

# Optional overrides. Defaults are resolved relative to the automation package.
# AUTOMATION_POLICY_PATH=config/policy.example.json
# AUTOMATION_EVIDENCE_DIR=../evidence
# AUTOMATION_HEADLESS=false
# ANTHROPIC_MODEL=claude-sonnet-5
